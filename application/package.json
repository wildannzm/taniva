		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prisma": "^6.10.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
