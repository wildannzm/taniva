# Database — MySQL
DB_USER=taniva
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Session
SESSION_SECRET=

# Application
PUBLIC_APP_URL=http://localhost:5173

# AI Vision Service (FastAPI + YOLOv8)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# NLP — OpenRouter
NLP_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NLP_TIMEOUT_MS=15000
OPENROUTER_APP_NAME=Taniva

# NLP — Local fallback (Ollama, disabled by default)
NLP_LOCAL_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Routing
OPENROUTESERVICE_API_KEY=

# Demo
DEMO_FALLBACK_ENABLED=false
MAX_UPLOAD_MB=8
